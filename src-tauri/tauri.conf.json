{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShiganshinaGG",
  "version": "1.0.0",
  "identifier": "app.shiganshinagg.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ShiganshinaGG",
        "width": 1360,
        "height": 880,
        "minWidth": 1080,
        "minHeight": 700,
        "center": true,
        "backgroundColor": "#0a0a0d"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}